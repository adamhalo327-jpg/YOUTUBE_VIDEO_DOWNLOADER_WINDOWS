name: Build YOUTUBE VIDEO DOWNLOADER 10.1 - Portable + Setup + Admin

on:
  workflow_dispatch:
  push:
    branches: [main, master]

permissions:
  contents: read

jobs:
  windows:
    runs-on: windows-latest
    timeout-minutes: 90
    steps:
      - name: Pobierz pliki projektu
        uses: actions/checkout@v6

      - name: Python 3.12 64-bit
        uses: actions/setup-python@v6
        with:
          python-version: '3.12'
          architecture: 'x64'

      - name: Utworz automatycznie plik instalatora Inno Setup
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          New-Item -ItemType Directory -Force 'installer' | Out-Null
          @'
          ; YOUTUBE VIDEO DOWNLOADER 10.1 PREMIUM ACCESS
          ; Per-user installation, no admin rights; includes all PyInstaller bundled files.
          #define AppName "YOUTUBE VIDEO DOWNLOADER"
          #define AppVersion "10.1"
          #define AppExe "YOUTUBE_VIDEO_DOWNLOADER.exe"
          
          [Setup]
          AppId={{61B99C23-C0B6-46AE-9DF1-14BF2E4FBAC9}
          AppName={#AppName}
          AppVersion={#AppVersion}
          AppVerName={#AppName} {#AppVersion}
          AppPublisher=YOUTUBE VIDEO DOWNLOADER
          DefaultDirName={localappdata}\Programs\YouTube Video Downloader
          DefaultGroupName={#AppName}
          DisableProgramGroupPage=yes
          PrivilegesRequired=lowest
          ArchitecturesAllowed=x64
          WizardStyle=modern
          Compression=lzma2
          SolidCompression=yes
          OutputDir=..\release
          OutputBaseFilename=YOUTUBE_VIDEO_DOWNLOADER_10_1_SETUP
          SetupIconFile=..\assets\YVD_ICON.ico
          UninstallDisplayIcon={app}\{#AppExe}
          CloseApplications=yes
          RestartApplications=no
          SetupLogging=yes
          
          [Languages]
          Name: "polish"; MessagesFile: "compiler:Languages\Polish.isl"
          Name: "english"; MessagesFile: "compiler:Default.isl"
          
          [Tasks]
          Name: "desktopicon"; Description: "Utwórz skrót na pulpicie"; GroupDescription: "Dodatkowe skróty:"; Flags: unchecked
          
          [Files]
          Source: "..\dist\YOUTUBE_VIDEO_DOWNLOADER\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
          Source: "..\assets\YVD_ICON.ico"; DestDir: "{app}"; Flags: ignoreversion
          
          [Icons]
          Name: "{userprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"; IconFilename: "{app}\YVD_ICON.ico"
          Name: "{userdesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon
          
          [Run]
          Filename: "{app}\{#AppExe}"; Description: "Uruchom {#AppName}"; Flags: nowait postinstall skipifsilent
          
          ; Do not remove %LOCALAPPDATA%\YouTubeVideoDownloader on uninstall:
          ; it contains user settings, queue, history and premium license state.
          '@ | Set-Content -Path 'installer/YOUTUBE_VIDEO_DOWNLOADER.iss' -Encoding utf8
          if (-not (Test-Path 'installer/YOUTUBE_VIDEO_DOWNLOADER.iss' -PathType Leaf)) { throw 'Nie udalo sie utworzyc pliku Inno Setup' }
          Write-Host 'Plik installer/YOUTUBE_VIDEO_DOWNLOADER.iss zostal utworzony podczas kompilacji.'

      - name: Kontrola plikow i zaleznosci
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $required = @('app.py', 'gui.py', 'core.py', 'licensing.py', 'requirements.txt', 'tools/premium_generator_gui.py', 'tools/issue_premium_code.py', 'updates.py', 'download_statistics.py', 'owner_registry.py', 'cloud_license.py', 'infinity_features.py', 'video_studio.py', 'admin_center.py', 'update_management.py', 'data_center.py', 'premium_access.py', 'assets/YVD_ICON.ico')
          $missing = @($required | Where-Object { -not (Test-Path $_ -PathType Leaf) })
          if ($missing.Count -gt 0) { throw ('Brakuje plikow w repozytorium: ' + ($missing -join ', ')) }
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt

      - name: Testy funkcji 1.0-10.1 i licencji Premium
        run: python -m unittest discover -s tests -v

      - name: Pobierz narzedzia yt-dlp, Deno, FFmpeg LGPL
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $ProgressPreference = 'SilentlyContinue'
          New-Item -ItemType Directory -Force -Path vendor | Out-Null

          Invoke-WebRequest -Uri 'https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe' -OutFile 'vendor/yt-dlp.exe'
          Invoke-WebRequest -Uri 'https://github.com/yt-dlp/yt-dlp/releases/latest/download/SHA2-256SUMS' -OutFile 'vendor/SHA2-256SUMS'
          $line = Get-Content 'vendor/SHA2-256SUMS' | Where-Object { $_ -match '\s+\*?yt-dlp\.exe$' } | Select-Object -First 1
          if (-not $line) { throw 'Brak sumy SHA256 dla yt-dlp.exe' }
          $expected = ($line.Trim() -split '\s+')[0].ToLowerInvariant()
          $actual = (Get-FileHash 'vendor/yt-dlp.exe' -Algorithm SHA256).Hash.ToLowerInvariant()
          if ($actual -ne $expected) { throw 'Niezgodna suma SHA256 dla yt-dlp' }
          & 'vendor/yt-dlp.exe' --version
          if ($LASTEXITCODE -ne 0) { throw 'Silnik yt-dlp nie uruchomil sie' }

          Invoke-WebRequest -Uri 'https://github.com/denoland/deno/releases/latest/download/deno-x86_64-pc-windows-msvc.zip' -OutFile 'deno.zip'
          Expand-Archive 'deno.zip' 'deno-unpacked' -Force
          $deno = Get-ChildItem 'deno-unpacked' -Recurse -Filter 'deno.exe' | Select-Object -First 1
          if (-not $deno) { throw 'Brak deno.exe' }
          Copy-Item $deno.FullName 'vendor/deno.exe'

          Invoke-WebRequest -Uri 'https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-lgpl.zip' -OutFile 'ffmpeg.zip'
          Expand-Archive 'ffmpeg.zip' 'ffmpeg-unpacked' -Force
          foreach ($binary in @('ffmpeg.exe','ffprobe.exe')) {
            $found = Get-ChildItem 'ffmpeg-unpacked' -Recurse -Filter $binary | Select-Object -First 1
            if (-not $found) { throw "Brakuje $binary" }
            Copy-Item $found.FullName "vendor/$binary"
          }
          & 'vendor/ffmpeg.exe' -version
          if ($LASTEXITCODE -ne 0) { throw 'FFmpeg nie uruchomil sie' }

      - name: Budowa kompletnego folderu aplikacji
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          python -m PyInstaller --noconfirm --clean --windowed --onedir --collect-all customtkinter --collect-all cryptography --hidden-import gui --hidden-import winotify --hidden-import infinity_features --hidden-import video_studio --hidden-import cloud_license --hidden-import premium_access --hidden-import data_center --icon assets/YVD_ICON.ico --add-data "assets/YVD_ICON.ico;assets" --name YOUTUBE_VIDEO_DOWNLOADER app.py
          if ($LASTEXITCODE -ne 0) { throw 'PyInstaller nie zbudowal EXE' }
          $dir = 'dist/YOUTUBE_VIDEO_DOWNLOADER'
          if (-not (Test-Path "$dir/YOUTUBE_VIDEO_DOWNLOADER.exe")) { throw 'Brak EXE' }
          if (-not (Test-Path "$dir/_internal/assets/YVD_ICON.ico" -PathType Leaf)) { throw "Brak ikony wewnatrz aplikacji" }
          if (-not (Test-Path "$dir/_internal" -PathType Container)) { throw 'Brak _internal, paczka Portable bylaby niepelna' }
          Copy-Item 'vendor/*.exe' $dir
          if (Test-Path 'README_PL.md') { Copy-Item 'README_PL.md' "$dir/INSTRUKCJA_PL.md" }
          if (Test-Path 'THIRD_PARTY_NOTICES.md') { Copy-Item 'THIRD_PARTY_NOTICES.md' $dir }
          foreach ($bin in @('yt-dlp.exe','deno.exe','ffmpeg.exe','ffprobe.exe')) {
            if (-not (Test-Path "$dir/$bin" -PathType Leaf)) { throw "Brak $bin" }
          }

      - name: ZIP Portable - caly folder EXE i _internal
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          New-Item -ItemType Directory -Force 'release' | Out-Null
          Compress-Archive -Path 'dist/YOUTUBE_VIDEO_DOWNLOADER' -DestinationPath 'release/YOUTUBE_VIDEO_DOWNLOADER_10_1_PORTABLE.zip' -CompressionLevel Optimal -Force
          if (-not (Test-Path 'release/YOUTUBE_VIDEO_DOWNLOADER_10_1_PORTABLE.zip')) { throw 'Nie powstal ZIP Portable' }

      - name: Pobierz kompilator instalatora Inno Setup
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $iscc = $null
          foreach ($base in @("${env:ProgramFiles(x86)}", "$env:ProgramFiles")) {
            if (Test-Path $base) {
              foreach ($folder in (Get-ChildItem $base -Directory -Filter 'Inno Setup*' -ErrorAction SilentlyContinue)) {
                $path = Join-Path $folder.FullName 'ISCC.exe'
                if (Test-Path $path) { $iscc = $path; break }
              }
            }
            if ($iscc) { break }
          }
          if (-not $iscc) {
            choco install innosetup --yes --no-progress
            if ($LASTEXITCODE -ne 0) { throw 'Nie udalo sie zainstalowac Inno Setup' }
          }

      - name: Kompiluj instalator Windows Setup.exe
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $iscc = $null
          foreach ($base in @("${env:ProgramFiles(x86)}", "$env:ProgramFiles")) {
            if (Test-Path $base) {
              foreach ($folder in (Get-ChildItem $base -Directory -Filter 'Inno Setup*' -ErrorAction SilentlyContinue)) {
                $path = Join-Path $folder.FullName 'ISCC.exe'
                if (Test-Path $path) { $iscc = $path; break }
              }
            }
            if ($iscc) { break }
          }
          if (-not $iscc) { throw 'Nie znaleziono ISCC.exe' }
          & $iscc 'installer/YOUTUBE_VIDEO_DOWNLOADER.iss'
          if ($LASTEXITCODE -ne 0) { throw 'Inno Setup nie zbudowal instalatora' }
          if (-not (Test-Path 'release/YOUTUBE_VIDEO_DOWNLOADER_10_1_SETUP.exe')) { throw 'Brak Setup.exe' }

      - name: Wygeneruj SHA256 dla instalatora
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $installer = 'release/YOUTUBE_VIDEO_DOWNLOADER_10_1_SETUP.exe'
          $hash = (Get-FileHash $installer -Algorithm SHA256).Hash.ToLowerInvariant()
          "$hash  YOUTUBE_VIDEO_DOWNLOADER_10_1_SETUP.exe" | Set-Content 'release/YVD_SETUP_SHA256.txt' -Encoding ascii

      - name: Publikuj Portable ZIP
        uses: actions/upload-artifact@v6
        with:
          name: YVD_10_1_PORTABLE_WINDOWS
          path: release/YOUTUBE_VIDEO_DOWNLOADER_10_1_PORTABLE.zip
          if-no-files-found: error
          retention-days: 30

      - name: Publikuj instalator Setup.exe
        uses: actions/upload-artifact@v6
        with:
          name: YVD_10_1_INSTALLER_WINDOWS
          path: |
            release/YOUTUBE_VIDEO_DOWNLOADER_10_1_SETUP.exe
            release/YVD_SETUP_SHA256.txt
          if-no-files-found: error
          retention-days: 30

      - name: Zbuduj panel wlasciciela Premium (oddzielny EXE)
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          python -m PyInstaller --noconfirm --clean --onefile --windowed --paths tools --collect-all cryptography --name YVD_PREMIUM_OWNER tools/premium_generator_gui.py
          if ($LASTEXITCODE -ne 0) { throw 'Nie udalo sie zbudowac panelu wlasciciela' }
          if (-not (Test-Path 'dist/YVD_PREMIUM_OWNER.exe')) { throw 'Brak YVD_PREMIUM_OWNER.exe' }

      - name: Buduj ADMIN CENTER 10.1 dla Premium Cloud
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          python -m PyInstaller --noconfirm --clean --onefile --windowed --collect-all customtkinter --name YVD_ADMIN_CENTER admin_center.py
          if ($LASTEXITCODE -ne 0) { throw 'Budowa ADMIN CENTER nie powiodla sie' }
          if (-not (Test-Path 'dist/YVD_ADMIN_CENTER.exe')) { throw 'Brak panelu ADMIN CENTER' }

      - name: Publikuj ADMIN CENTER 10.1
        uses: actions/upload-artifact@v6
        with:
          name: YVD_10_1_ADMIN_CENTER_WINDOWS
          path: dist/YVD_ADMIN_CENTER.exe
          if-no-files-found: error
          retention-days: 30

      - name: Publikuj panel wlasciciela bez klucza prywatnego
        uses: actions/upload-artifact@v6
        with:
          name: YVD_10_1_PREMIUM_OWNER_WINDOWS
          path: dist/YVD_PREMIUM_OWNER.exe
          if-no-files-found: error
          retention-days: 30
